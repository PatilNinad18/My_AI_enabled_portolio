# Server only. Copy to .env.local and add your Gemini API key.
NINAD_AI_API_KEY=
NINAD_AI_MODEL=gemini-3.5-flash-lite
NINAD_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Deployment: use a single IP header overwritten by your trusted edge proxy.
# Never use a header that lets the client supply its own address.
# NINAD_AI_CLIENT_IP_HEADER=
# NINAD_AI_VISITOR_SECRET=

# Shared Upstash Redis REST storage for serverless or multiple instances.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Alternative for a single Node 22.13+ server with a durable local disk.
# NINAD_AI_SQLITE_PATH=/var/lib/ninad/assistant.sqlite

# Optional aggregate budgets for the Gemini project. Set these below its quotas.
# NINAD_AI_GEMINI_CALLS_PER_MINUTE=5
# NINAD_AI_GEMINI_CALLS_PER_DAY=40
